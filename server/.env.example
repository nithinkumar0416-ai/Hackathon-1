PORT=5000
JWT_SECRET=your-secret-key-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
# Google Gemini API key:
# Recommended format: Standard API Key starting with 'AIzaSy...' from Google AI Studio (aistudio.google.com)
# or Google Cloud Console (APIs & Services -> Credentials -> Create API Key).
# If the key is missing or invalid, the backend automatically uses the intelligent document analysis fallback.
GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com
CLIENT_URL=http://localhost:5173
OWNER_USER_ID=your-supabase-user-id
